# .env.example — documents which keys this project expects, with no values.
# Copy to .env and fill in real values there. .env is gitignored; this file is not.

ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
# Fallback for deployed runners with no credentials file on disk (e.g. the
# Trigger.dev cloud build) — full service-account JSON as a single-line string.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
TRIGGER_SECRET_KEY=
TRIGGER_API_URL=
TRIGGER_PROJECT_REF=
