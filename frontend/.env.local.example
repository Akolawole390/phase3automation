# Copy to frontend/.env.local and fill in real values for local development.
# Use the Trigger.dev "dev" environment secret key while running `npx trigger.dev dev`
# locally (repo root). Find it in the Trigger.dev dashboard: Project > API Keys > dev.

TRIGGER_SECRET_KEY=

# Optional — only needed if self-hosting Trigger.dev; omit for Trigger.dev Cloud.
# TRIGGER_API_URL=

# For the "My reports" pages — same spreadsheet as the backend, and the
# service-account JSON as a single-line string (no file-path option here).
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Password gate (proxy.ts) — anyone without these credentials is redirected
# to /login. Cookie stores a hash of them, never the plaintext values.
SITE_USERNAME=
SITE_PASSWORD=
